{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalPassThroughEnv": [
    "ANTHROPIC_API_KEY",
    "AGENT_MODEL",
    "INTENT_MODEL",
    "USER_ID",
    "DATA_DIR",
    "MOCK_SEED",
    "SEED_MEMORIES",
    "PORT"
  ],
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    }
  }
}
