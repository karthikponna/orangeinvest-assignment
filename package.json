{
  "name": "errand-agent",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "cli": "bun run apps/cli/src/index.ts",
    "dev": "turbo run dev --filter=@errand/server --filter=@errand/web",
    "server": "bun run apps/server/src/index.ts",
    "web": "cd apps/web && bunx vite",
    "typecheck": "tsc --noEmit -p tsconfig.json && turbo run typecheck",
    "reset-data": "rm -rf data"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.6.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.4",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3"
  }
}
